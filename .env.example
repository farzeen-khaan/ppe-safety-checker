# Copy this file to .env and fill in the values. Never commit .env.

# F4 incident summary and F8 digest summary — the language model's API key.
# Provider: Google Gemini; free key from https://aistudio.google.com (see decisions.md).
LLM_API_KEY=
# Optional: a model to try first (defaults: gemini-3.5-flash-lite, then gemini-flash-lite-latest)
LLM_MODEL=

# F5 incident log — Postgres on Neon (Console → project → Connect → pooled connection string).
# Locally: the dev branch. On Vercel: the main (production) branch. Use the pooled connection string.
# Without it, analyses are not saved and the digest fails.
DATABASE_URL=
# Automated tests only: the Neon test branch (tests empty its tables). Never the dev or main branch.
# If empty, database tests are skipped and the rest run offline.
DATABASE_URL_TEST=

# F7 violation alerts — Discord channel → Edit Channel → Integrations → Webhooks → Copy URL.
# The URL is a secret (anyone with it can post to the channel).
DISCORD_WEBHOOK_URL=
# Set to true to send violation alerts; anything else (or empty) turns them off.
# The daily digest (python -m src.digest) does not check this: it sends whenever it is run.
ALERTS_ENABLED=

# F8 daily digest — webhook of the #daily-digest channel (a secret too).
# If empty, the digest posts to DISCORD_WEBHOOK_URL instead.
DISCORD_DIGEST_WEBHOOK_URL=

# Web app rate limit — secret salt for hashing client IPs (at least 32 characters; never commit it).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
RATE_LIMIT_SALT=
