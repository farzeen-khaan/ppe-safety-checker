# Copy this file to .env and fill in the values. Never commit .env.

# F4 incident report — free key from https://aistudio.google.com
GEMINI_API_KEY=
# Optional: a Gemini model to try first (defaults: gemini-3.5-flash-lite, then gemini-flash-lite-latest)
GEMINI_MODEL=

# F5 incident log — optional; default is db/incidents.db in the project
INCIDENT_DB_PATH=

# F7 violation alerts, F8 digest — Discord channel → Edit Channel → Integrations → Webhooks → Copy URL.
# The URL is a secret (anyone with it can post to the channel).
DISCORD_WEBHOOK_URL=
# Set to true to send alerts; anything else (or empty) turns them off
ALERTS_ENABLED=
